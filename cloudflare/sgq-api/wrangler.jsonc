{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "techdall-sgq-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-26",
  "vars": {
    "APP_ORIGIN": "https://galvanicadanuta1-ai.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "techdall-sgq",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
